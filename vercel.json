{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/auto-finalize", "schedule": "0 18 * * *" },
    { "path": "/api/cron/auto-finalize", "schedule": "0 19 * * *" }
  ]
}
