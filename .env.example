# ── Slack: winner announcements ───────────────────────────────
# Option A (recommended): a Slack bot token with chat:write.
# Swap the announcement channel by changing SLACK_CHANNEL only.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=test-gauntlet-notification

# Option B: an Incoming Webhook URL (channel is fixed to the webhook).
SLACK_WEBHOOK_URL=

# ── Shared storage: Vercel KV / Upstash Redis ─────────────────
# Create a KV store in the Vercel dashboard and it injects these.
# Leave blank locally to use a JSON file (api/.local_state.json).
KV_REST_API_URL=
KV_REST_API_TOKEN=
